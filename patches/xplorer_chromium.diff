--- a/chrome/BUILD.gn
+++ b/chrome/BUILD.gn
@@ -1430,6 +1430,17 @@ if (is_win) {
       chrome_dylib_version,
       "-current_version",
       chrome_dylib_version,
+      # XPLORER: rpath for the linked Sparkle.framework
+      # (id @rpath/Sparkle.framework/...) -> Contents/Frameworks.
+      # @loader_path is RELATIVE TO THIS FRAMEWORK BINARY (same for the
+      # browser process AND every helper that loads it), so it resolves
+      # for all process types; @executable_path/../Frameworks only works
+      # for the main exe (helpers live deeper -> their ../Frameworks is
+      # empty -> dlopen crash). Binary is at
+      # Contents/Frameworks/Xplorer Framework.framework/Versions/<V>/, so
+      # @loader_path/../../.. == Contents/Frameworks. Keep both.
+      "-Wl,-rpath,@loader_path/../../..",
+      "-Wl,-rpath,@executable_path/../Frameworks",
     ]
 
     if (!is_component_build) {
