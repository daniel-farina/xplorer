diff --git a/chrome/app/chrome_main_delegate.cc b/chrome/app/chrome_main_delegate.cc
index 5655d73273..53e7ce71c9 100644
--- a/chrome/app/chrome_main_delegate.cc
+++ b/chrome/app/chrome_main_delegate.cc
@@ -1101,6 +1101,38 @@ void ChromeMainDelegate::SetupTracing() {
 }
 
 std::optional<int> ChromeMainDelegate::BasicStartupComplete() {
+  // XPLORER: AI-native defaults (never throttle backgrounded tabs) +
+  // XPLORER: privacy — disable the component updater (Google pings), the
+  // XPLORER: Finch field-trial config, and the Variations seed fetch
+  // XPLORER: (empty server URLs). Brave/ungoogled-style: no phone-home.
+  {
+    base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+    for (const char* sw : {"disable-renderer-backgrounding",
+                           "disable-backgrounding-occluded-windows",
+                           "disable-background-timer-throttling",
+                           "disable-component-update",
+                           "disable-field-trial-config",
+                           "disable-domain-reliability",
+                           "disable-sync",
+                           "no-pings"}) {
+      if (!cmd->HasSwitch(sw))
+        cmd->AppendSwitch(sw);
+    }
+    for (const char* url_sw : {"variations-server-url",
+                               "variations-insecure-server-url"}) {
+      if (!cmd->HasSwitch(url_sw))
+        cmd->AppendSwitchASCII(url_sw, "");
+    }
+    if (!cmd->HasSwitch("disable-features"))
+      cmd->AppendSwitchASCII("disable-features",
+                             "CalculateNativeWinOcclusion,ChromeWhatsNewUI");
+    if (!cmd->HasSwitch("enable-features"))
+      cmd->AppendSwitchASCII("enable-features",
+                             "AiModeOmniboxEntryPoint");
+    if (!cmd->HasSwitch("top-chrome-touch-ui"))
+      cmd->AppendSwitchASCII("top-chrome-touch-ui", "enabled");
+  }
+
 #if BUILDFLAG(IS_CHROMEOS)
   ash::BootTimesRecorder::Get()->SaveChromeMainStats();
 #endif
