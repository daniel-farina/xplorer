+// The system tooltip opens under the cursor, which sits in the titlebar, so
+// AppKit clips the top of the bubble. This one is a separate window placed
+// fully below the row.
+class QuietBarTip : public ui::EventObserver, public views::ViewObserver {
+ public:
+  static void Install(ToolbarView* toolbar) {
+    if (Tips().contains(toolbar)) {
+      Tips()[toolbar]->NoteButtons();
+      return;
+    }
+    Tips()[toolbar] = new QuietBarTip(toolbar);
+  }
+
+  QuietBarTip(const QuietBarTip&) = delete;
+  QuietBarTip& operator=(const QuietBarTip&) = delete;
+
+ private:
+  explicit QuietBarTip(ToolbarView* toolbar) : toolbar_(toolbar) {
+    observation_.Observe(toolbar);
+    Attach();
+    NoteButtons();
+  }
+
+  ~QuietBarTip() override {
+    pending_.Stop();
+    monitor_.reset();
+    widget_.reset();
+  }
+
+  static std::map<ToolbarView*, QuietBarTip*>& Tips() {
+    static base::NoDestructor<std::map<ToolbarView*, QuietBarTip*>> tips;
+    return *tips;
+  }
+
+  void Attach() {
+    if (monitor_ || !toolbar_->GetWidget()) {
+      return;
+    }
+    monitor_ = views::EventMonitor::CreateWindowMonitor(
+        this, toolbar_->GetWidget()->GetNativeWindow(),
+        {ui::EventType::kMouseMoved, ui::EventType::kMouseExited});
+  }
+
+  void Note(views::View* view) {
+    if (!view) {
+      return;
+    }
+    const std::u16string live(view->GetTooltipText());
+    if (live.empty()) {
+      return;
+    }
+    text_[view] = live;
+    view->SetTooltipText(std::u16string());
+    if (view->GetAccessibleName().empty()) {
+      view->GetViewAccessibility().SetName(live);
+    }
+  }
+
+  void NoteButtons() {
+    Note(toolbar_->GetViewByID(VIEW_ID_BACK_BUTTON));
+    Note(toolbar_->GetViewByID(VIEW_ID_FORWARD_BUTTON));
+    Note(toolbar_->GetViewByID(VIEW_ID_RELOAD_BUTTON));
